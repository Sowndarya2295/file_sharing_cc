{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateBucketObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::dropboxer-files-<ACCOUNT_ID>/dropboxer/uploads/*"
    },
    {
      "Sid": "MetadataTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/DropBoxerShares",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/DropBoxerShares/index/shareId-index"
      ]
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:*"
    }
  ]
}
